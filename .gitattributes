# Scripts e configs montados em containers Linux precisam de LF mesmo em
# checkouts Windows (core.autocrlf=true).
*.sh   text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.yml  text eol=lf
Dockerfile text eol=lf
# Código Go sempre em LF: com core.autocrlf=true o checkout em CRLF faz o
# `gofmt -l .` listar todos os arquivos, embora o conteúdo versionado esteja
# formatado (ADR-030).
*.go   text eol=lf
*.sql  text eol=lf
go.mod text eol=lf
go.sum text eol=lf
