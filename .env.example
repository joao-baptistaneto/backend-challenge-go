# Valores locais de exemplo. NÃO contém segredos reais.
# Copie para .env e ajuste conforme o ambiente.

# --- Aplicação ---
APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
# Prazo total de parada do servidor HTTP (espera de drenagem + Shutdown);
# estourado, as conexões restantes são fechadas à força.
SHUTDOWN_TIMEOUT=15s
# Acesso a /metrics: internal (token do serviço interno; padrão) ou public
# (sem autenticação; só onde a porta não é exposta publicamente).
METRICS_ACCESS=internal

# --- Servidor HTTP ---
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Espera entre /health/ready DOWN e o fechamento do listener (0s a 1m, menor
# que SHUTDOWN_TIMEOUT). Atrás de um balanceador, use alguns segundos.
HTTP_DRAIN_DELAY=0s

# --- PostgreSQL ---
# Docker Compose publica o PostgreSQL no host em 5433 (5432 costuma estar
# ocupada por um PostgreSQL local). Senha de DESENVOLVIMENTO (ADR-026).
DATABASE_URL=postgres://wallet:wallet-dev-pw@localhost:5433/wallet?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_CONNECT_TIMEOUT=30s

# --- AWS SQS (LocalStack) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_INBOUND_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_INBOUND_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# Fila FIFO dos eventos de integração publicados pela outbox (ADR-024):
# MessageGroupId = aggregateId, MessageDeduplicationId = eventId.
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# --- Consumidor SQS (fila de entrada; ADR-022) ---
# Nome do consumidor na inbox (consumer_name). Mudá-lo zera a deduplicação
# pela inbox (a idempotência por chave continua valendo).
SQS_CONSUMER_NAME=wager-transactions-consumer
# Máximo de MessageGroupIds processados em paralelo por instância.
SQS_CONSUMER_CONCURRENCY=4
# Long polling (0s a 20s, segundos inteiros). No shutdown o consumidor espera
# o último long polling terminar (até SQS_WAIT_TIME + 5s, em paralelo com
# SQS_DRAIN_TIMEOUT) antes de liberar mensagens; entra no prazo do stop.
SQS_WAIT_TIME=20s
# Visibilidade pedida no ReceiveMessage (1s a 12h, segundos inteiros).
SQS_VISIBILITY_TIMEOUT=30s
# Prazo de processamento de uma mensagem (menor que SQS_VISIBILITY_TIMEOUT).
SQS_PROCESS_TIMEOUT=15s
# Backoff de falha transitória: base·2^(receiveCount-1), com teto (segundos inteiros).
SQS_RETRY_BASE_DELAY=1s
SQS_RETRY_MAX_DELAY=5m
# Prazo, no shutdown, para concluir as mensagens em processamento; depois
# disso elas são liberadas (visibilidade 0) para reentrega.
SQS_DRAIN_TIMEOUT=10s
# Tentativas de uma falha transitória antes do envio explícito à DLQ.
# Precisa ser menor que o maxReceiveCount da RedrivePolicy da fila (5
# recomendado), que fica como rede de segurança; o start falha se não for.
SQS_MAX_ATTEMPTS=3

# --- OIDC (Keycloak) ---
OIDC_ISSUER_URL=http://localhost:8081/realms/junglegaming
OIDC_AUDIENCE=wallet-api
# Opcional: vazio → descoberto via {OIDC_ISSUER_URL}/.well-known/openid-configuration.
# Útil quando o app alcança o IdP por outro host (rede do compose) que o do iss.
# No Docker Compose o issuer continua http://localhost:8081/... (KC_HOSTNAME
# fixo) e o JWKS vem de http://keycloak:8080/... pela rede interna (ADR-026).
OIDC_JWKS_URL=http://localhost:8081/realms/junglegaming/protocol/openid-connect/certs
# Claim (string) do token com o providerId autorizado.
OIDC_PROVIDER_CLAIM=provider_id
# Papéis (realm_access.roles ou resource_access[OIDC_ROLES_CLIENT].roles).
OIDC_PROVIDER_ROLE=wager-provider
OIDC_INTERNAL_ROLE=wallet-internal
# Client cujos papéis de resource_access valem; vazio = OIDC_AUDIENCE.
# OIDC_ROLES_CLIENT=wallet-api
# Tolerância de relógio para exp/nbf/iat (0s a 2m).
OIDC_CLOCK_SKEW=30s

# --- Publisher da outbox (ADR-024) ---
# Espera entre ciclos quando o último claim veio vazio (1ms a 24h).
OUTBOX_POLL_INTERVAL=1s
# Lote reivindicado por ciclo (1 a 1000; no máximo um evento por agregado).
OUTBOX_BATCH_SIZE=50
# Lease persistido do lote (1s a 1h, maior que OUTBOX_POLL_INTERVAL): evento
# não marcado nesse prazo (crash) volta a ser elegível para outra instância.
OUTBOX_LEASE=30s
# Eventos do lote publicados em paralelo por instância (1 a 100).
OUTBOX_CONCURRENCY=4
# Prazo de cada chamada de um evento (SendMessage e marcação); o dobro deve
# ser menor que OUTBOX_LEASE.
OUTBOX_PUBLISH_TIMEOUT=5s
# Prazo, no shutdown, para concluir as publicações em voo.
OUTBOX_DRAIN_TIMEOUT=10s
# Backoff persistido após falha de publicação: base·2^(tentativa−1), com teto.
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m

# --- Worker de referências pendentes e PENDING órfãos (ADR-023) ---
# Máximo de buscas da referência (contando a do aceite) e prazo desde a
# criação; esgotado qualquer um, a operação vira REJECTED REFERENCE_NOT_FOUND.
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL=10m
# Backoff entre buscas: base·2^(tentativa−1), com teto (persistido em next_attempt_at).
PENDING_REFERENCE_RETRY_BASE_DELAY=2s
PENDING_REFERENCE_RETRY_MAX_DELAY=1m
# Espera entre ciclos quando o último lote não veio cheio.
PENDING_WORKER_POLL_INTERVAL=1s
# Tamanho do lote reivindicado e itens processados em paralelo por instância.
PENDING_WORKER_BATCH_SIZE=20
PENDING_WORKER_CONCURRENCY=4
# Lease persistido do lote (1s a 24h): item não concluído nesse prazo (crash)
# volta a ser elegível para outra instância.
PENDING_WORKER_LEASE=30s
# Prazo de retomada de um item (menor que PENDING_WORKER_LEASE).
PENDING_WORKER_PROCESS_TIMEOUT=5s
# Prazo, no shutdown, para concluir os itens em voo.
PENDING_WORKER_DRAIN_TIMEOUT=10s
# Idade mínima de um PENDING sem next_attempt_at para ser retomado como órfão.
PENDING_ORPHAN_GRACE=30s

# --- Docker Compose / testes de integração (ADR-026) ---
# Não lidas pela aplicação; usadas por `make compose-smoke` e
# `make test-integration-compose` contra a stack do docker-compose.yml.
# Segredos de client são os valores de DESENVOLVIMENTO do realm importado
# (deploy/keycloak/realm-junglegaming.json); nunca use em produção.
# TEST_DATABASE_URL=postgres://wallet:wallet-dev-pw@localhost:5433/wallet?sslmode=disable
# SQS_ENDPOINT=http://localhost:4566
# KEYCLOAK_URL=http://localhost:8081
# KEYCLOAK_CLIENT_ID=internal-service
# KEYCLOAK_CLIENT_SECRET=internal-service-dev-secret
